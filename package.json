{
  "name": "terces",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "tsx scripts/write-headers.ts && tsx scripts/copy-ort.ts",
    "dev": "vite",
    "prebuild": "tsx scripts/write-headers.ts && tsx scripts/copy-ort.ts",
    "build": "vite build && tsx scripts/prerender.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p tsconfig.functions.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint:text": "tsx scripts/lint-text.ts",
    "geo:build": "tsx scripts/build-geo.ts",
    "models:fetch": "tsx scripts/fetch-models.ts",
    "budget": "tsx scripts/budget.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm lint:text && pnpm build && pnpm test:e2e",
    "icons": "tsx scripts/make-icons.ts",
    "deploy:setup": "tsx scripts/deploy.ts setup",
    "deploy:preview": "tsx scripts/deploy.ts preview",
    "deploy:prod": "tsx scripts/deploy.ts prod"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "exifr": "7.1.3",
    "onnxruntime-web": "1.31.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "topojson-client": "3.1.0",
    "world-atlas": "2.0.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261107.1",
    "@eslint/js": "10.0.1",
    "@napi-rs/canvas": "1.1.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/piexifjs": "1.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/topojson-client": "3.1.5",
    "@types/topojson-specification": "1.0.5",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fflate": "0.8.3",
    "globals": "17.14.0",
    "happy-dom": "21.0.4",
    "jose": "6.2.15",
    "onnxruntime-node": "1.31.1",
    "piexifjs": "1.0.6",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.0",
    "workbox-window": "7.4.1",
    "wrangler": "4.158.0"
  }
}
