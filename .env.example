# Cloudflare Access settings of the /admin page. Copy to .env (not committed) for local dev:
# `wrangler pages dev` reads it. In production they are Pages secrets, set once with
# `pnpm wrangler pages secret put <NAME> --project-name terces`.

# Zero Trust > Settings > Team name and domain
ACCESS_TEAM_DOMAIN=myteam.cloudflareaccess.com
# Zero Trust > Access > Applications > (the /admin app) > Application Audience (AUD) Tag
ACCESS_AUD=
